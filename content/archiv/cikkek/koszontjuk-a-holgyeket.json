":["em"],"text":"lássuk az örömöt, arcukon csillogjon."},{"_key":"f35c33a412fe3","_type":"span","marks":[],"text":"\n"},{"_key":"f35c33a412fe4","_type":"span","marks":["em"],"text":"Szemünkben ragyogjon a szeretet fénye,"},{"_key":"f35c33a412fe5","_type":"span","marks":[],"text":"\n"},{"_key":"f35c33a412fe6","_type":"span","marks":["em"],"text":"szívünkből áradjon, sose legyen vége."}],"markDefs":[],"style":"normal"},{"_key":"00570210dfde","_type":"block","children":[{"_key":"00570210dfde0","_type":"span","marks":["em"],"text":"Hisz ez csak egy nap, az érzés legyen örök,"},{"_key":"00570210dfde1","_type":"span","marks":[],"text":"\n"},{"_key":"00570210dfde2","_type":"span","marks":["em"],"text":"arcukon lássunk mi nap mint nap örömöt."},{"_key":"00570210dfde3","_type":"span","marks":[],"text":"\n"},{"_key":"00570210dfde4","_type":"span","marks":["em"],"text":"Naponta tegyünk meg valamit épp ezért,"},{"_key":"00570210dfde5","_type":"span","marks":[],"text":"\n"},{"_key":"00570210dfde6","_type":"span","marks":["em"],"text":"boldogságot nyújtsunk megélt szép percekért.\""}],"markDefs":[],"style":"normal"}]}