b9015","_type":"span","marks":[],"text":": Medgyesi, Nagy (3), Takács"}],"markDefs":[],"style":"normal"},{"_key":"c3cf7271d6fb","_type":"block","children":[{"_key":"c3cf7271d6fb0","_type":"span","marks":["strong"],"text":"Tóth László, vezetőedző:"}],"markDefs":[],"style":"normal"},{"_key":"55182597ff6b","_type":"block","children":[{"_key":"55182597ff6b0","_type":"span","marks":["em"],"text":"- Játékban és mentalitásban is jobb erőt képviseltünk, mint ellenfelünk, ezért megérdemelt a győzelmünk. Úgy léptünk pályára, ahogy egy bajnokesélyes csapatnak kell, nem lenézve, sőt tisztelve ellenfelünket. Gratulálok a fiúknak! Nincs sok vissza, nem engedhetünk ki, továbbra is ezt a mentalitást és játékot kell tartanunk ahhoz, hogy sikeres évet zárhassunk!"}],"markDefs":[],"style":"normal"},{"_key":"3360cc1ff5a1","_type":"block","children":[{"_key":"3360cc1ff5a10","_type":"span","marks":["strong","0fe0f3f445e1"],"text":"A mérkőzésen készült fotók ITT találhatóak!"}],"markDefs":[{"_key":"0fe0f3f445e1","_type":"link","href":"https://www.facebook.com/pg/VKLA.hu/photos/?tab=album&album_id=2327312743996144"}],"style":"normal"},{"_key":"fb3e7eab464a","_type":"block","children":[{"_key":"fb3e7eab464a0","_type":"span","marks":["strong"],"text":"MLSZ U17 II. osztály - 28. forduló"},{"_key":"fb3e7eab464a1","_type":"span","marks":[],"text":"\n"},{"_key":"fb3e7eab464a2","_type":"span","marks":["strong"],"text":"Vasas Kubala Akadémia - MOL Vidi FC: 3-0 (1-0)"},{"_key":"fb3e7eab464a3","_type":"span","marks":[],"text":"\n"},{"_key":"fb3e7eab464a4","_type":"span","marks":["underline"],"text":"2019.05.18., szombat 10.00"},{"_key":"fb3e7eab464a5","_type":"span","marks":[],"text":"\n"},{"_key":"fb3e7eab464a6","_type":"span","marks":["underline"],"text":"Fáy utcai Sportcentrum"},{"_key":"fb3e7eab464a7","_type":"span","marks":[],"text":"\n"},{"_key":"fb3e7eab464a8","_type":"span","marks":["underline"],"text":"1139 Budapest, Fáy utca 58."},{"_key":"fb3e7eab464a9","_type":"span","marks":[],"text":"\n"},{"_key":"fb3e7eab464a10","_type":"span","marks":["underline"],"text":"Összeállítás:"},{"_key":"fb3e7eab464a11","_type":"span","marks":[],"text":" Németh, Komódi, Bonifert, Kiss-Szemán, Puskás, Buza, Varga, Juhász, Kapornai, Józsa, Bartos\n"},{"_key":"fb3e7eab464a12","_type":"span","marks":["underline"],"text":"Cserék"},{"_key":"fb3e7eab464a13","_type":"span","marks":[],"text":": Gyurkó, Jármy, Szegezdi, Horváth D., Farkas (Molnár, Lakatos K.)\n"},{"_key":"fb3e7eab464a14","_type":"span","marks":["underline"],"text":"Gólszerzők"},{"_key":"fb3e7eab464a15","_type":"span","marks":[],"text":": Kapornai, Józsa, Gyurkó"}],"markDefs":[],"style":"normal"},{"_key":"6670d850a873","_type":"block","children":[{"_key":"6670d850a8730","_type":"span","marks":["underline"],"text":"Komódi László, vezetőedző:"}],"markDefs":[],"style":"normal"},{"_key":"de9c028fc1c6","_type":"block","children":[{"_key":"de9c028fc1c60","_type":"span","marks":["em"],"text":"- Több szempontból is fontos volt számunkra a MOL Vidi FC elleni mérkőzés! Az UTE elleni gyenge játékunkat mindenképpen szerettük volna kijavítani és persze egy győzelemmel ismét az élre állni a tabellán! Ennek tudatában mégsem mi, hanem a Vidi kezdte jobban a mérkőzést! A letámadásaikat jól szervezték, agresszívan próbáltak labdákat szerezni, ezzel megakadályozni a játéképítéseinket. Mi kevésbé alkalmaztuk erre a megfelelő ellenszert, mert kevés volt a támogató mozgás, ennek hiányában viszont pontatlan megoldások és passzaink voltak. Sok labdát veszítettünk, ráadásul ezekből veszélyes akciókat alakíthatott ki az ellenfél. 30 perc után kezdtünk el olyan megoldásokat, stíluselemeket alkalmazni, melyekkel már mi is veszélyesebbek lettünk, így akár két góllal is vezethettünk volna, ha nem hibázzuk el a jogosan megítélt büntetőt! A második félidőben volt az igazi áttörés a játékunk minőségében, miután megbeszéltük a szünetben a hiányosságokat! A labdaszerzéseink utáni átmenetek itt már jól működtek és gyorsan be tudtuk fejezni a létszámfölényes támadásainkat. Sikerült kihasználni a helyzeteket, illetve annak is örülök, hogy egyéni és csapat teljesítményben nagyot javultunk ! Gratulálok mindkét csapat játékához!"}],"markDefs":[],"style":"normal"},{"_key":"d263fda34a14","_type":"block","children":[{"_key":"d263fda34a140","_type":"span","marks":["strong","2b70c396b5fc"],"text":"A mérkőzésen készült fotók ITT találhatóak!"}],"markDefs":[{"_key":"2b70c396b5fc","_type":"link","href":"https://www.facebook.com/pg/VKLA.hu/photos/?tab=album&album_id=2327207094006709"}],"style":"normal"},{"_key":"44910c02d645","_type":"block","children":[{"_key":"44910c02d6450","_type":"span","marks":["strong"],"text":"MLSZ U14 I. osztály - 28. forduló"},{"_key":"44910c02d6451","_type":"span","marks":[],"text":"\n"},{"_key":"44910c02d6452","_type":"span","marks":["strong"],"text":"Kaposvári Rákóczi BFLA - Vasas Kubala Akadémia: 0-4 (0-2)"},{"_key":"44910c02d6453","_type":"span","marks":[],"text":"\n"},{"_key":"44910c02d6454","_type":"span","marks":["underline"],"text":"2019.05.18., szombat 13.00"},{"_key":"44910c02d6455","_type":"span","marks":[],"text":"\n"},{"_key":"44910c02d6456","_type":"span","marks":["underline"],"text":"Kaposvári Rákóczi BFLA Sporttelep"},{"_key":"44910c02d6457","_type":"span","marks":[],"text":"\n"},{"_key":"44910c02d6458","_type":"span","marks":["underline"],"text":"7400 Kaposvár, Cseri út 14."},{"_key":"44910c02d6459","_type":"span","marks":[],"text":"\n"},{"_key":"44910c02d64510","_type":"span","marks":["underline"],"text":"Összeállítás:"},{"_key":"44910c02d64511","_type":"span","marks":[],"text":" Bánfalvi, Burger, Lázár, Pállai, Farkas, Kis, Szabó, Szendeff, Lukács, Pócs, Tóth G.\n"},{"_key":"44910c02d64512","_type":"span","marks":["underline"],"text":"Cserék"},{"_key":"44910c02d64513","_type":"span","marks":[],"text":": Busa, Vass, Simon, Kovács K., Holdas, Necula\n"},{"_key":"44910c02d64514","_type":"span","marks":["underline"],"text":"Gólszerzők"},{"_key":"44910c02d64515","_type":"span","marks":[],"text":": Szendeff, Tóth (2), Holdas"}],"markDefs":[],"style":"normal"},{"_key":"f88efeb36e2e","_type":"block","children":[{"_key":"f88efeb36e2e0","_type":"span","marks":["underline"],"text":"Nagy Gábor, vezetőedző:"}],"markDefs":[],"style":"normal"},{"_key":"a6fb90fd23fe","_type":"block","children":[{"_key":"a6fb90fd23fe0","_type":"span","marks":["em"],"text":"- Az első negyedórában kiegyenlített játék folyt, a Kaposvár nagyon fegyelmezetten és agresszíven védekezett. Az idő előre haladtával azonban átvettük a játék irányítását, kombinatív játékban ellenfelünk fölé nőttünk és sorra alakítottuk ki a helyzeteket, melyekből kettőt gólra váltottunk. A második félidőben tovább tudtuk növelni előnyünket, a srácok élvezték a játékot. A mérkőzés képe alapján megérdemelt győzelmet arattunk."}],"markDefs":[],"style":"normal"},{"_key":"a13e4619c5ed","_type":"block","children":[{"_key":"a13e4619c5ed0","_type":"span","marks":["strong"],"text":"Csapataink következő programja:"}],"markDefs":[],"style":"normal"},{"_key":"d641ffd98489","_type":"block","children":[{"_key":"d641ffd984890","_type":"span","marks":["underline"],"text":"III.Kerületi TVE (NB3) - U19 Vasas Kubala Akadémia felkészülési mérkőzés"},{"_key":"d641ffd984891","_type":"span","marks":[],"text":"\n2019.05.22., szerda 18.00\nIII. ker. TVE Sporttelep\n1037 Budapest, Kalap u. 1-3."}],"markDefs":[],"style":"normal"},{"_key":"69638a7c0b0c","_type":"block","children":[{"_key":"69638a7c0b0c0","_type":"span","marks":["underline"],"text":"MLSZ U19 II. osztály - 29. forduló"},{"_key":"69638a7c0b0c1","_type":"span","marks":[],"text":"\n"},{"_key":"69638a7c0b0c2","_type":"span","marks":["underline"],"text":"Vasas Kubala Akadémia - KTE LA"},{"_key":"69638a7c0b0c3","_type":"span","marks":[],"text":"\n2019.05.25., szombat 10.00\n1139 Budapest, Fáy u. 58."}],"markDefs":[],"style":"normal"},{"_key":"9cfe14d66a50","_type":"block","children":[{"_key":"9cfe14d66a500","_type":"span","marks":["underline"],"text":"MLSZ U17 II. oszt