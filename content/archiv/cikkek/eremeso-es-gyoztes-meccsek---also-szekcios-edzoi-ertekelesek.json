ok és nagyon büszke vagyok a csapatra!"}],"markDefs":[],"style":"normal"},{"_key":"8c885631f04e","_type":"image","url":"/archiv/kepek/1815bf27685f048a8c83f05f4b6ee19f56a03e2a-1000x637.webp"},{"_key":"5630a3192e4e","_type":"block","children":[{"_key":"5630a3192e4e0","_type":"span","marks":["strong"],"text":"U7 Főnix Kupa"},{"_key":"5630a3192e4e1","_type":"span","marks":[],"text":"\n2019.11.23., szombat 09.00\nFőnix Gold FC Sporttelep\n8000 Székesfehérvár-Fecskepart, Gombócleső utca 4054/1 hrsz."}],"markDefs":[],"style":"normal"},{"_key":"ec8c967bb888","_type":"block","children":[{"_key":"ec8c967bb8880","_type":"span","marks":["strong"],"text":"Összeállítás"},{"_key":"ec8c967bb8881","_type":"span","marks":[],"text":": Effenberger, Galambos, Kovács, Lipcsei, Mészáros, Pinte, Walcz"}],"markDefs":[],"style":"normal"},{"_key":"ed565698a987","_type":"block","children":[{"_key":"ed565698a9870","_type":"span","marks":["strong"],"text":"Eredmények:"}],"markDefs":[],"style":"normal"},{"_key":"45db5fa65bb8","_type":"block","children":[{"_key":"45db5fa65bb80","_type":"span","marks":["strong"],"text":"Vasas Kubala Akadémia – Komárom: 1-3"},{"_key":"45db5fa65bb81","_type":"span","marks":[],"text":"\n"},{"_key":"45db5fa65bb82","_type":"span","marks":["strong"],"text":"Gólszerző:"},{"_key":"45db5fa65bb83","_type":"span","marks":[],"text":" Mészáros (1)\n"},{"_key":"45db5fa65bb84","_type":"span","marks":["strong"],"text":"Vasas Kubala Akadémia – ETO: FC Győr: 3-2"},{"_key":"45db5fa65bb85","_type":"span","marks":[],"text":"\n"},{"_key":"45db5fa65bb86","_type":"span","marks":["strong"],"text":"Gólszerző:"},{"_key":"45db5fa65bb87","_type":"span","marks":[],"text":" Galambos (3)\n"},{"_key":"45db5fa65bb88","_type":"span","marks":["strong"],"text":"Vasas Kubala Akadémia – Bp. Honvéd FC: 6-2"},{"_key":"45db5fa65bb89","_type":"span","marks":[],"text":"\n"},{"_key":"45db5fa65bb810","_type":"span","marks":["strong"],"text":"Gólszerzők:"},{"_key":"45db5fa65bb811","_type":"span","marks":[],"tex