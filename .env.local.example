# Sanity CMS — a projekt létrehozása után töltsd ki, és mentsd .env.local néven.
# Projekt létrehozása: https://www.sanity.io/manage (Create project),
# vagy terminálból: npx sanity init --bare
# A CORS-hoz a Manage-ben add hozzá: http://localhost:3000 és a Vercel domain.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Szerkesztési jogú API token (migrációhoz / importhoz kell, a Manage → API → Tokens alatt)
SANITY_API_WRITE_TOKEN=
