# Sanity CMS — a projekt létrehozása után töltsd ki, és mentsd .env.local néven.
# Projekt létrehozása: https://www.sanity.io/manage (Create project),
# vagy terminálból: npx sanity init --bare
# A CORS-hoz a Manage-ben add hozzá: http://localhost:3000 és a Vercel domain.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Szerkesztési jogú API token (migrációhoz / importhoz kell, a Manage → API → Tokens alatt)
SANITY_API_WRITE_TOKEN=

# SEO — az oldal kanonikus címe (sitemap, OG-linkek) és az indexelés kapcsolója.
# Élesítéskor (végleges domain): NEXT_PUBLIC_SITE_URL=https://vkla.hu és
# NEXT_PUBLIC_SITE_INDEXABLE=true — addig a robots minden keresőt kitilt.
NEXT_PUBLIC_SITE_URL=https://vkla.vercel.app
NEXT_PUBLIC_SITE_INDEXABLE=false

# Szülői fiók + képzési díj számlák. Mindkettő a Vercel projekt Storage
# füléről jön: Neon (Postgres) és Blob (Access: PRIVATE!). Nélkülük a
# szülői fiók „hamarosan” állapotban van, a weboldal többi része fut.
# Az adatbázis-séma létrehozása: node scripts/db-migrate.mjs
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# A pénzügy (számlafeltöltő) e-mail-címei, vesszővel elválasztva:
ADMIN_EMAILS=

# Bankkártyás fizetés számlánként (Stripe) — a klub jövő év elejére halasztotta,
# ezért alapból KI. Bekapcsolás: KARTYAS_FIZETES=1 + Stripe-kulcsok.
# Webhook-végpont a Stripe-ban: /api/fiok/stripe-webhook (checkout.session.completed)
KARTYAS_FIZETES=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Űrlap-emailek (Resend) — kulcs nélkül az űrlapgombok inaktívak.
# Kulcs: https://resend.com -> API Keys (re_... kezdetű).
RESEND_API_KEY=
# Feladó — csak Resendben igazolt domainről mehet; addig a resend.dev teszt-feladó
# használható (az viszont KIZÁRÓLAG a saját Resend-fiók e-mail címére kézbesít).
RESEND_FROM=VKLA weboldal <onboarding@resend.dev>
# Staging-átirányítás: ha ki van töltve, MINDEN űrlap-levél erre a címre megy
# (tárgyban jelölve az eredeti címzettet) — élesítéskor törölni!
FORMS_TO_OVERRIDE=
